{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stepcast",
  "version": "0.4.0",
  "identifier": "dk.renepoulsen.stepcast",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Stepcast",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data: asset: http://asset.localhost; worker-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost blob: data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$VIDEO/Stepcast/**",
          "$HOME/Movies/Stepcast/**",
          "$RESOURCE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "resources": {
      "fonts/": "fonts/",
      "../../extension/dist/chrome/": "extension/"
    },
    "category": "Video",
    "shortDescription": "Screen recorder for support videos",
    "license": "MIT",
    "macOS": {
      "minimumSystemVersion": "12.3",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3NTVDRUQyQkE2MjJFRkYKUldUL0xtSzYwczVWTnk2Q1E1WC83MXJCeUpkY3ltWFkyNk1rV2Y4YThYSlowVGxUS3k0RXV0WDYK",
      "endpoints": [
        "https://github.com/rene-poulsen/stepcast/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
